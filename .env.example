# Which LLM provider to use: "openai" | "gemini" | "mock"
# Leave as "mock" (or omit keys) to run the full pipeline offline/without cost.
MODEL_PROVIDER=mock

# OpenAI
OPENAI_API_KEY=
MODEL_NAME=gpt-4o-mini

# Gemini (used if MODEL_PROVIDER=gemini)
GEMINI_API_KEY=
# MODEL_NAME=gemini-1.5-flash

# Validation
VALIDATION_CONFIDENCE_THRESHOLD=0.75

# Storage
DB_PATH=unihack.db
UPLOAD_DIR=data/sample_products
